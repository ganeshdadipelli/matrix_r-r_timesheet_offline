# ─────────────────────────────────────────────
# Matrix Smart Technologies — Environment File
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values

# PostgreSQL Database URL
# NOTE: If password has @ symbol, replace @ with %40
# Example: password "Ganesh@123" → "Ganesh%40123"
DATABASE_URL="postgresql://postgres:Ganesh%40123@localhost:5432/matrix_dashboard"

# JWT Secret Key — Change this to a long random string in production!
# Generate one at: https://generate-secret.now.sh/64
JWT_SECRET="matrix_smart_technologies_super_secret_jwt_key_change_this_in_production_2026"

# JWT expiry
JWT_EXPIRES_IN="24h"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Matrix Smart Technologies"
